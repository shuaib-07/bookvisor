{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookVisor",
  "version": "0.1.1",
  "identifier": "com.bookvisor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BookVisor - Local-First AI Bookmark Manager",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
