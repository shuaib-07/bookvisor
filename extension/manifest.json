{
  "manifest_version": 2,
  "name": "BookVisor Bridge (Zen / Firefox)",
  "version": "1.1.0",
  "description": "Real-time bidirectional bookmark sync bridge between Zen Browser / Firefox and BookVisor desktop app.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "ws://127.0.0.1:49152/*",
    "http://127.0.0.1:49152/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "BookVisor Bridge"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookvisor-bridge@zen-browser.app",
      "strict_min_version": "109.0"
    }
  }
}

