{
  "manifest_version": 3,
  "name": "BookVisor Bridge",
  "version": "1.1.0",
  "description": "Real-time bidirectional bookmark sync bridge between your browser and BookVisor desktop app.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "ws://127.0.0.1:49152/*",
    "http://127.0.0.1:49152/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "BookVisor Bridge"
  }
}
